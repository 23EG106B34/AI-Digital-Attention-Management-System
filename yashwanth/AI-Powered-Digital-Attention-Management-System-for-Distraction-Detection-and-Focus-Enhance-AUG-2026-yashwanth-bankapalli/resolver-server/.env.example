# FocusGuard AI - Resolver Backend Configuration
# Copy this file to .env and set your API key. NEVER commit .env to Git!

# LLM Provider API Key (e.g., Gemini, OpenAI, or compatible provider)
LLM_API_KEY=your_google_api_key_here

# LLM Model Name (default: gemini-3.5-flash-lite)
LLM_MODEL=gemini-3.5-flash-lite

# LLM Request Timeout in seconds (default: 3.0)
LLM_TIMEOUT_SECONDS=3.0
